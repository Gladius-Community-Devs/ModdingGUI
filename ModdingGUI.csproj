<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Nullable: "annotations" here, "enable" in Core and the test project.
         This project is the WinForms shell: thin glue plus legacy editors that are still being
         ported onto Core APIs (Randomizer and Team Builder move in Phases 6-7). WinForms event
         handlers and designer fields are not nullable-aware, so flow analysis here produced 107
         warnings that described the framework, not defects — the type declarations on public
         members are still annotated for callers. Logic belongs in Core, where nullability is
         enforced as an error; a shell file flips to "#nullable enable" when it is ported. -->
    <Nullable>annotations</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ludo.ico</ApplicationIcon>

    <!-- Enable single-file publishing and include native libraries -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Adjust the runtime identifier as appropriate (e.g. win-x64, win-x86) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- MSB3277 (WebView2's WPF WindowsBase) is silenced repo-wide in
         Directory.Build.props; see the note there. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ModdingGUI.Tests\**" />
    <None Remove="ModdingGUI.Tests\**" />
    <Content Remove="ModdingGUI.Tests\**" />
    <EmbeddedResource Remove="ModdingGUI.Tests\**" />

    <Compile Remove="ModdingGUI.Core\**" />
    <None Remove="ModdingGUI.Core\**" />
    <Content Remove="ModdingGUI.Core\**" />
    <EmbeddedResource Remove="ModdingGUI.Core\**" />

    <Compile Remove="ModdingGUI.Mcp\**" />
    <None Remove="ModdingGUI.Mcp\**" />
    <Content Remove="ModdingGUI.Mcp\**" />
    <EmbeddedResource Remove="ModdingGUI.Mcp\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ludo.ico">
      <!-- Embedded in the exe via ApplicationIcon for the window icon; also copied loose so a dev
           build can fall back to it if the executable icon cannot be read. -->
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TextureConversion\pttp_tga.py">
      <!-- Vendored from GladiusTools (_tga_view/pttp_tga.py): the toolbelt beside the exe has no texture
           converter, and an unpack needs one to turn the PTTP map pages into PNGs for the Grid Builder. -->
      <Link>tools\pttp_tga.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NkitConvert\**\*">
      <!-- NKit's ConvertToISO (Nanook), free to redistribute per the project owner, so an NKit image can be
           rebuilt without asking the user to install anything. Copied to tools\nkit beside the exe. -->
      <Link>tools\nkit\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools_v009\dist\tools_v009\**\*">
      <!-- The bundled toolchain: tools_v009.exe carries its own Python, so modding needs no interpreter installed.
           Copied to tools\v009 beside the exe, which is where Toolchain.BundledExecutableIn looks for it. -->
      <Link>tools\v009\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="skills\skills_catalog.json">
      <Link>skills\skills_catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="classdefs\classdefs_catalog.json">
      <Link>classdefs\classdefs_catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="encounters\encounters_catalog.json">
      <Link>encounters\encounters_catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tables\schools_catalog.json">
      <Link>tables\schools_catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tables\leagues_catalog.json">
      <Link>tables\leagues_catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dol\skills_fields.json">
      <Link>dol\skills_fields.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dol\classdefs_fields.json">
      <Link>dol\classdefs_fields.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dol\encounters_fields.json">
      <Link>dol\encounters_fields.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ModdingGUI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ModdingGUI.Core\ModdingGUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="maps\" />
  </ItemGroup>

  <!-- Defence in depth for MSB3821. Resource files pick up a zone identifier when the repo is copied
       from a zip or a network share, and VS's MSBuild refuses to process a marked .resx even though the
       SDK's MSBuild tolerates it. The script clears that stream before the build, so a marked file can
       never make "builds here, fails there". Windows-only; a failure is logged but not fatal. -->
  <Target Name="UnblockDesignerResourceFiles" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\unblock-resources.ps1&quot; -Directory &quot;$(MSBuildProjectDirectory)&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="normal" />
  </Target>

</Project>
